# --- Telegram ---
# Token ottenuto da @BotFather
TELEGRAM_BOT_TOKEN=8994364734:AAESQwFjkEJIlR45mArQZ7uozRMXgLLbbNE

# Chat ID di destinazione del broadcast giornaliero.
# Per ottenerlo: scrivi al tuo bot, poi visita
# https://api.telegram.org/bot<TOKEN>/getUpdates e copia "chat":{"id":...}.
